<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth (Android 11 以下用) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Android 11 以下では BLE スキャンに ACCESS_FINE_LOCATION が必須 -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Bluetooth (Android 12+ 用) — neverForLocation で位置情報除外 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot completed (端末起動後の自動再開) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Wakelock (CPU をスリープさせない) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      画面オフ/スリープ/スクリーンセーバを OS レベルで無効化するため。
      signature|privileged|development 権限なので、一度きりの ADB で付与して使う（runbook §4.6）:
        adb shell pm grant com.kimiterrace.tvbridge android.permission.WRITE_SECURE_SETTINGS
        adb shell appops set com.kimiterrace.tvbridge WRITE_SETTINGS allow
      未付与なら KeepAwakeManager は no-op（前面再アサート等の他防御に委ねる）。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 正確なアラーム（スケジュール機能用） -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:targetApi="tiramisu" />

    <!-- 他アプリの上に重ねる（黒画面 Activity 表示の補助） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Bluetooth LE 必須機能 -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Android TV / Google TV カテゴリ宣言 — TV ランチャーに表示 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".TvBridgeApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_dialog_info"
        android:banner="@android:drawable/ic_dialog_info"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TVBleBridge"
        tools:targetApi="34">

        <!-- ステータス表示用 Activity（リモコン操作対応） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- no-DOキオスク: HOMEランチャー化（HOME押下でサイネージへ戻す） -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- BLE スキャン常駐サービス -->
        <service
            android:name=".BleService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- FCM 受信（遠隔起動）: v2 が 🔴 検知時に wake プッシュ → BleService.ensureRunning -->
        <service
            android:name=".FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- スケジュールで OFF 時間中に表示する全画面黒 Activity -->
        <activity
            android:name=".BlackScreenActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.TVBleBridge.Black"
            android:turnScreenOn="false" />

        <!-- フルスクリーンキオスク：WebView でサイネージを表示 -->
        <activity
            android:name=".SignageActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.TVBleBridge.Black"
            android:turnScreenOn="true">
            <!-- 外部から am start で起動可能（adb で開発検証用） -->
            <intent-filter>
                <action android:name="com.kimiterrace.tvbridge.OPEN_SIGNAGE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- スケジュール ON/OFF アラーム受信 -->
        <receiver
            android:name=".ScheduleAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 常駐の最後の砦：定期ウォッチドッグ / クラッシュ後の自動蘇生アラーム受信 -->
        <receiver
            android:name=".WatchdogReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 端末起動時に BleService を自動開始 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- APK 更新(再インストール)直後にも常駐/ウォッチドッグを再武装する -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- SwitchBot プラグ制御 / ネット復旧 / reboot のローカルトリガ（adb 検証用 / 将来の内部利用）。
             ⚠ REBOOT_NOW(DO機=HKCはstandbyに落ちる)・NET_WIFI_*・SET_* 等「端末を落としうる」操作を受けるため
             exported=false で外部アプリからの無認証トリガを遮断する。adb は -n でコンポーネント指定すれば
             非exportedでも届く（手順書は全て `am broadcast -n .../.PlugCommandReceiver -a …` 形で記述済）。 -->
        <receiver
            android:name=".PlugCommandReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kimiterrace.tvbridge.PLUG_ON" />
                <action android:name="com.kimiterrace.tvbridge.PLUG_OFF" />
                <action android:name="com.kimiterrace.tvbridge.PLUG_CYCLE" />
                <action android:name="com.kimiterrace.tvbridge.PLUG_TOGGLE" />
                <action android:name="com.kimiterrace.tvbridge.NET_CYCLE" />
                <action android:name="com.kimiterrace.tvbridge.NET_REVALIDATE" />
                <action android:name="com.kimiterrace.tvbridge.NET_WIFI_TOGGLE" />
                <action android:name="com.kimiterrace.tvbridge.NET_WIFI_API" />
                <action android:name="com.kimiterrace.tvbridge.NET_WIFI_A11Y" />
                <action android:name="com.kimiterrace.tvbridge.REBOOT_NOW" />
                <action android:name="com.kimiterrace.tvbridge.SET_MORNING_REBOOT" />
                <action android:name="com.kimiterrace.tvbridge.SET_DAILY_RECOVERY" />
                <action android:name="com.kimiterrace.tvbridge.SET_RECOVERY_WIFI" />
            </intent-filter>
        </receiver>

        <!--
          Wi-Fi 自動張り直し用アクセシビリティ・サービス（非DO機の "疑似 Wi-Fi 再起動"）。
          有効化は adb で一度きり:
            adb shell settings put secure enabled_accessibility_services \
              com.kimiterrace.tvbridge/com.kimiterrace.tvbridge.WifiRecoveryAccessibilityService
            adb shell settings put secure accessibility_enabled 1
        -->
        <service
            android:name=".WifiRecoveryAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/wifi_recovery_a11y" />
        </service>

        <!--
          Device Owner / 端末管理者レシーバ。
          プロビジョニング時に `dpm set-device-owner …/.TvDeviceAdminReceiver` で端末所有者へ昇格する。
          所有者になると lockNow()（夜間の画面 OFF）と lock task（キオスク）が PC 不要で使える。
        -->
        <receiver
            android:name=".TvDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
