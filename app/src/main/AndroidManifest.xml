<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth (Android 11 以下用) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Android 11 以下では BLE スキャンに ACCESS_FINE_LOCATION が必須 -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Bluetooth (Android 12+ 用) — neverForLocation で位置情報除外 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot completed (端末起動後の自動再開) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wakelock (CPU をスリープさせない) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      画面オフ/スリープ/スクリーンセーバを OS レベルで無効化するため。
      signature|privileged|development 権限なので、一度きりの ADB で付与して使う（runbook §4.6）:
        adb shell pm grant com.kimiterrace.tvbridge android.permission.WRITE_SECURE_SETTINGS
        adb shell appops set com.kimiterrace.tvbridge WRITE_SETTINGS allow
      未付与なら KeepAwakeManager は no-op（前面再アサート等の他防御に委ねる）。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 正確なアラーム（スケジュール機能用） -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:targetApi="tiramisu" />

    <!-- 他アプリの上に重ねる（黒画面 Activity 表示の補助） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Bluetooth LE 必須機能 -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Android TV / Google TV カテゴリ宣言 — TV ランチャーに表示 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_dialog_info"
        android:banner="@android:drawable/ic_dialog_info"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TVBleBridge"
        tools:targetApi="34">

        <!-- ステータス表示用 Activity（リモコン操作対応） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BLE スキャン常駐サービス -->
        <service
            android:name=".BleService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- スケジュールで OFF 時間中に表示する全画面黒 Activity -->
        <activity
            android:name=".BlackScreenActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.TVBleBridge.Black"
            android:turnScreenOn="false" />

        <!-- フルスクリーンキオスク：WebView でサイネージを表示 -->
        <activity
            android:name=".SignageActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.TVBleBridge.Black"
            android:turnScreenOn="true">
            <!-- 外部から am start で起動可能（adb で開発検証用） -->
            <intent-filter>
                <action android:name="com.kimiterrace.tvbridge.OPEN_SIGNAGE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- スケジュール ON/OFF アラーム受信 -->
        <receiver
            android:name=".ScheduleAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 端末起動時に BleService を自動開始 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          Device Owner / 端末管理者レシーバ。
          プロビジョニング時に `dpm set-device-owner …/.TvDeviceAdminReceiver` で端末所有者へ昇格する。
          所有者になると lockNow()（夜間の画面 OFF）と lock task（キオスク）が PC 不要で使える。
        -->
        <receiver
            android:name=".TvDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
