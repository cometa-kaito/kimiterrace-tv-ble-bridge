<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 用最小ステータス UI。リモコンの D-Pad だけで操作できるよう
    focusable な要素は縦に並べる。文字は大きめ（22sp〜32sp）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="48dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="キミテラス BLE ブリッジ"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="SwitchBot 人感センサの BLE を受信し、Vercel に送信します"
            android:textColor="#CCCCCC"
            android:textSize="16sp" />

        <!-- 設定セクション -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="センサーMAC"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/input_mac"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="DC:A5:B3:C2:98:D7"
            android:padding="12dp"
            android:textSize="22sp"
            android:singleLine="true"
            android:inputType="textCapCharacters" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Webhook URL（?key=… を含むフル URL）"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/input_webhook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="https://www.school-signage.net/api/switchbot-webhook?key=..."
            android:padding="12dp"
            android:textSize="22sp"
            android:singleLine="true"
            android:inputType="textUri" />

        <!-- ボタン -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="20dp"
                android:text="▶ 開始 / 再起動"
                android:textSize="22sp" />

            <Space
                android:layout_width="16dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/button_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="20dp"
                android:text="■ 停止"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- ステータスセクション -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:background="#444444" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ステータス"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#1A1A1A"
            android:text="状態: -"
            android:textColor="#88FF88"
            android:textSize="22sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/text_last_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#1A1A1A"
            android:text="最終検知: -"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/text_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#1A1A1A"
            android:text="累計: 0件   未送信: 0件   最終同期: 未試行"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="このアプリはバックグラウンドで動作します。設定を一度行えばリモコンで離れても受信は継続します。"
            android:textColor="#888888"
            android:textSize="14sp" />

        <!-- ===== サイネージ + リモート設定セクション ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:background="#444444" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖥 サイネージ表示（内蔵キオスク）"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fully Kiosk 代替の内蔵 WebView。指定 URL をフルスクリーン表示します。"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="サイネージ URL"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/input_signage_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="https://www.school-signage.net/ など"
            android:padding="12dp"
            android:textSize="22sp"
            android:singleLine="true"
            android:inputType="textUri" />

        <CheckBox
            android:id="@+id/cb_autolaunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="端末起動時に自動でサイネージを開く"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_launch_signage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="16dp"
                android:text="▶ サイネージ起動"
                android:textSize="20sp" />

            <Space
                android:layout_width="16dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/button_save_signage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="16dp"
                android:text="設定保存"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="🌐 リモート設定エンドポイント (任意)"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="設定すると、ここに 1 分ごとに GET して リモートで設定変更できます"
            android:textColor="#888888"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_config_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="https://www.school-signage.net/api/tv/config?key=..."
            android:padding="12dp"
            android:textSize="22sp"
            android:singleLine="true"
            android:inputType="textUri" />

        <!-- ===== スケジュールセクション ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:background="#444444" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📺 TV ON/OFF スケジュール"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="OFF 時間中は全画面真っ黒のオーバーレイで「見た目 OFF」を実現します。"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Switch
                android:id="@+id/switch_schedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="スケジュール有効"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌅 ON 時刻"
                    android:textColor="#AAAAAA"
                    android:textSize="18sp" />

                <TimePicker
                    android:id="@+id/picker_on_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner" />
            </LinearLayout>

            <Space
                android:layout_width="24dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌙 OFF 時刻"
                    android:textColor="#AAAAAA"
                    android:textSize="18sp" />

                <TimePicker
                    android:id="@+id/picker_off_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="適用曜日"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <CheckBox android:id="@+id/cb_sun" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="日" android:textColor="#FF8888" android:textSize="18sp" />
            <CheckBox android:id="@+id/cb_mon" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="月" android:textColor="#FFFFFF" android:textSize="18sp" />
            <CheckBox android:id="@+id/cb_tue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="火" android:textColor="#FFFFFF" android:textSize="18sp" />
            <CheckBox android:id="@+id/cb_wed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="水" android:textColor="#FFFFFF" android:textSize="18sp" />
            <CheckBox android:id="@+id/cb_thu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="木" android:textColor="#FFFFFF" android:textSize="18sp" />
            <CheckBox android:id="@+id/cb_fri" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="金" android:textColor="#FFFFFF" android:textSize="18sp" />
            <CheckBox android:id="@+id/cb_sat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="土" android:textColor="#8888FF" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_save_schedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="16dp"
                android:text="スケジュール保存"
                android:textSize="20sp" />

            <Space
                android:layout_width="16dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/button_test_black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="16dp"
                android:text="今すぐ黒画面テスト"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_schedule_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="#1A1A1A"
            android:text="次回 ON: -   次回 OFF: -"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>
