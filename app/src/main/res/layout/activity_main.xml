<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 用最小ステータス UI。リモコンの D-Pad だけで操作できるよう
    focusable な要素は縦に並べる。文字は大きめ（22sp〜32sp）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="48dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="キミテラス BLE ブリッジ"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="SwitchBot 人感センサの BLE を受信し、Vercel に送信します"
            android:textColor="#CCCCCC"
            android:textSize="16sp" />

        <!-- 設定セクション -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="センサーMAC"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/input_mac"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="DC:A5:B3:C2:98:D7"
            android:padding="12dp"
            android:textSize="22sp"
            android:singleLine="true"
            android:inputType="textCapCharacters" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Webhook URL（?key=… を含むフル URL）"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/input_webhook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="https://www.school-signage.net/api/switchbot-webhook?key=..."
            android:padding="12dp"
            android:textSize="22sp"
            android:singleLine="true"
            android:inputType="textUri" />

        <!-- ボタン -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="20dp"
                android:text="▶ 開始 / 再起動"
                android:textSize="22sp" />

            <Space
                android:layout_width="16dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/button_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="20dp"
                android:text="■ 停止"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- ステータスセクション -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:background="#444444" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ステータス"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#1A1A1A"
            android:text="状態: -"
            android:textColor="#88FF88"
            android:textSize="22sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/text_last_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#1A1A1A"
            android:text="最終検知: -"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/text_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#1A1A1A"
            android:text="累計: 0件   未送信: 0件   最終同期: 未試行"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="このアプリはバックグラウンドで動作します。設定を一度行えばリモコンで離れても受信は継続します。"
            android:textColor="#888888"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
